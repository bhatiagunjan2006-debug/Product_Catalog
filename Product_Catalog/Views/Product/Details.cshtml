@model Product_Catalog.Models.Product

<!DOCTYPE html>

<html>
<head>
    <title>Product Details</title>
</head>

<body>

    <h2>Product Details</h2>

    @if (Model != null)
    {
        <p>
            <b>Product ID:</b> @Model.ProductId
        </p>

        <p>
            <b>Product Name:</b> @Model.ProductName
        </p>

        <p>
            <b>Description:</b> @Model.Description
        </p>

        <p>
            <b>Price:</b> @Model.Price
        </p>

        <p>
            <b>Category:</b> @Model.Category
        </p>
    }
    else
    {
        <p>Product not found</p>
    }

    <br />

    @Html.ActionLink(
        "Back to Product Catalogue",
        "Index",
        "Product"
    )

</body>
</html>